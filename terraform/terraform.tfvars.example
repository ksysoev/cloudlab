# Example Terraform variables file
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git (it's in .gitignore)

# DigitalOcean API Token
# Get from: https://cloud.digitalocean.com/account/api/tokens
do_token = "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Packer-built snapshot ID
# After running the build-image workflow, paste the snapshot ID output here
# (or set it as a TF Cloud workspace variable called cloudlab_image_id).
# Find snapshot IDs: https://cloud.digitalocean.com/images/snapshots/droplets
cloudlab_image_id = "123456789"

# Region where the droplet will be created
# Available regions: nyc1, nyc3, sfo3, ams3, sgp1, lon1, fra1, tor1, blr1, syd1
do_region = "sgp1"

# SSH port (non-standard for security)
# Default: 1923 (instead of standard port 22)
ssh_port = 1923

# Droplet size
# s-1vcpu-1gb     = $6/mo  - 1GB RAM, 1 vCPU, 25GB SSD
# s-1vcpu-2gb     = $12/mo - 2GB RAM, 1 vCPU, 50GB SSD
# s-2vcpu-2gb     = $18/mo - 2GB RAM, 2 vCPU, 60GB SSD
# s-2vcpu-4gb     = $24/mo - 4GB RAM, 2 vCPU, 80GB SSD
droplet_size = "s-1vcpu-1gb"

# Droplet name
droplet_name = "cloudlab-swarm"

# SSH public key registered with DigitalOcean (emergency/root access only)
# This key is attached to the droplet at the DO level for recovery via console.
# Generate with: ssh-keygen -t ed25519 -C "cloudlab-root"
ssh_public_key = "ssh-ed25519 AAAA... root-key@host"

# SSH public key injected into /home/deployer/.ssh/authorized_keys by cloud-init.
# THIS is the key used for all normal SSH access and CI/CD deployments.
# Must match the private key stored in the SWARM_SSH_KEY / SSH_PRIVATE_KEY GitHub secret.
# Derive the public key from your CI private key with: ssh-keygen -y -f private_key
deployer_ssh_public_key = "ssh-ed25519 AAAA... deployer-key@host"

# Note: IP whitelisting is not used as no static IP is available
# The firewall allows connections from any IP to the following ports:
# - TCP: 1923 (SSH), 80 (HTTP), 443 (HTTPS), 8081 (Custom)
# - UDP: 443 (HTTP/3)
# All other ports are blocked by default

# Grafana Cloud configuration (optional)
# Get these values from the Grafana Cloud portal or the Alloy install command.
# Leave empty to skip Grafana Cloud integration during provisioning.
grafana_cloud_logs_url    = "" # Loki push URL
grafana_cloud_logs_id     = "" # Loki instance ID
grafana_cloud_metrics_url = "" # Prometheus push URL
grafana_cloud_metrics_id  = "" # Prometheus instance ID
grafana_cloud_api_key     = "" # Shared API key

# Weekly backups (adds ~20% to droplet cost)
backups_enabled = false

# Tags for organizing resources
tags = ["cloudlab", "swarm", "terraform", "production"]

# Cloudflare DNS configuration
# Get API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone.DNS (Edit)
# Recommended: Use "Edit zone DNS" template
cloudflare_api_token = "your_cloudflare_api_token_here"

# Domain name hosted on Cloudflare
# This must match your Cloudflare zone exactly
cloudflare_zone_name = "make-it-public.dev"
