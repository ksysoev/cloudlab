# Example Packer variable overrides
# Copy to cloudlab.pkrvars.hcl and fill in real values.
# DO NOT commit the real file — it is in .gitignore.
#
# Usage:
#   packer build -var-file=cloudlab.pkrvars.hcl .

do_token        = "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
do_region       = "sgp1"
do_builder_size = "s-1vcpu-1gb"
ssh_port        = 1923
